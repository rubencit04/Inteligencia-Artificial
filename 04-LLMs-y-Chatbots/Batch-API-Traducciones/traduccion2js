// Resultado con json schema

import "dotenv/config";
import OpenAI from "openai";
import { traductorSchema } from "./schema/traductor-Schema.js";

const cliente = new OpenAI({
    apiKey: process.env.OPENAI_API_KEY,
});

export async function traducirProducto(producto) {
    const response = await cliente.responses.create({
        model: "gpt-5-nano",
        input: [
            {
                role: "developer",
                content: "Eres un traductor profesional. Traduce el titulo y la descripcion del producto al español manteniendo el tono promocional"
            },
            {
                role: "user",
                content: JSON.stringify(producto)
            }
        ],
        text: {
            format: {
                type: "json_schema",
                name: "translatedProduct",
                schema: traductorSchema,
                strict: true
            }
        }
    });
    return response.output_text;
}